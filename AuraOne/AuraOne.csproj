<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>za.co.auraone.assistant</ApplicationId>
    <ApplicationVersion>4</ApplicationVersion>
    <ApplicationDisplayVersion>1.3</ApplicationDisplayVersion>
    <!--
      Enables trim analyzers and full trimming during Release mode.
      To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/trimming-options#trimming-granularity
    -->
    <TrimMode>partial</TrimMode>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <ApplicationTitle>Aura One</ApplicationTitle>
    <AndroidSdkDirectory Condition="Exists('C:\Program Files (x86)\Android\android-sdk')">C:\Program Files (x86)\Android\android-sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="Exists('C:\Program Files\Android\openjdk\jdk-21.0.8')">C:\Program Files\Android\openjdk\jdk-21.0.8</JavaSdkDirectory>
  </PropertyGroup>
  <ItemGroup><Compile Remove="MainActivity.cs;NativeLive.cs" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <AndroidJavaSource Update="PlatformJava/**/*.java" Bind="false" />
    <AndroidMavenLibrary Include="com.alphacephei:vosk-android" Version="0.3.75" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="net.java.dev.jna:jna" Version="5.18.1" ArtifactFilename="jna-5.18.1.aar" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="com.google.ai.edge.litertlm:litertlm-android" Version="0.18.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.code.gson:gson" Version="2.14.0" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="com.google.errorprone:error_prone_annotations" Version="2.48.0" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-reflect" Version="2.4.0" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="org.jetbrains.kotlin:kotlin-stdlib" Version="2.4.0" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="org.jetbrains.kotlinx:kotlinx-coroutines-android" Version="1.11.0" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm" Version="1.11.0" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="org.jetbrains:annotations" Version="23.0.0" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:api" Version="13.1.5" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:provider" Version="13.1.5" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:aidl" Version="13.1.5" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="dev.rikka.shizuku:shared" Version="13.1.5" Repository="https://repo.maven.apache.org/maven2" Bind="false" />
    <AndroidMavenLibrary Include="androidx.annotation:annotation" Version="1.3.0" Repository="Google" Bind="false" />
  </ItemGroup>
</Project>
